{
  "name": "@donegeon/client",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint not configured'",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:screenshots": "PW_SCREENSHOT_MODE=on playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:install": "playwright install chromium",
    "test:audit:contract": "node --test tests/unit/audit-contract.test.ts",
    "test:audit:certified": "node tests/e2e/audit/run-certified.mjs",
    "test:audit": "playwright test tests/e2e/audit",
    "test:audit:m1": "playwright test tests/e2e/audit/m1-core-lifecycle.spec.ts",
    "test:audit:m2": "playwright test tests/e2e/audit/m2-organization.spec.ts",
    "test:audit:m3": "playwright test tests/e2e/audit/m3-scheduling.spec.ts",
    "test:audit:m4": "playwright test tests/e2e/audit/m4-quickadd-search.spec.ts",
    "test:audit:m5": "playwright test tests/e2e/audit/m5-collaboration.spec.ts",
    "test:audit:m6": "playwright test tests/e2e/audit/m6-browser-acceptance.spec.ts"
  },
  "dependencies": {
    "@linaria/core": "^8.2.0",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "@tanstack/solid-query": "6.0.0-rc.0",
    "idb": "^8.0.3",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.3.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@wyw-in-js/vite": "^2.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "3.0.0-next.27",
    "workbox-build": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  }
