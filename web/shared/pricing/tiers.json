  "faqs": [
    {
      "question": "What is included today?",
      "answer": "Donegeon includes fast task capture, recurring schedules, personal board gameplay, calendar sync, and a collaboration path for teams that upgrade to Pro."
    },
    {
      "question": "Can we learn the product before signing up?",
      "answer": "Yes. The docs and blog cover core workflows, feature walkthroughs, and product updates so teams can understand how Donegeon works before they commit."
    },
    {
      "question": "Are walkthrough videos available?",
      "answer": "Selected guides can include videos so new users can see features in action instead of relying on screenshots and text alone."
    },
    {
      "question": "What is the difference between Free and Pro?",
      "answer": "Free is designed for solo use and the core board workflow. Pro adds shared boards, invitations, role controls, and board-member management, with a 14-day trial to get started."
    }
