{
  "name": "donegeon-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:client": "turbo dev --filter=@donegeon/client",
    "dev:marketing": "turbo dev --filter=@donegeon/marketing",
    "build": "turbo build",
    "build:client": "turbo build --filter=@donegeon/client",
    "build:marketing": "turbo build --filter=@donegeon/marketing",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "turbo": "^2.10.8"
  }
}
