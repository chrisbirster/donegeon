# Donegeon Server Configuration

# Server Settings
DONEGEON_HTTP_PORT=42069
DONEGEON_LOG_LEVEL=debug
DONEGEON_REQUIRE_AUTH=true

# Database Settings
DONEGEON_DB_PATH=donegeon.db

# API Tokens (for non-browser clients)
DONEGEON_API_TOKEN=change-me-in-prod-write-token
DONEGEON_READONLY_API_TOKEN=change-me-in-prod-read-token

# Cookie Security Settings
DONEGEON_COOKIE_SIGNING_KEY=secret-key-at-least-32-chars-long
DONEGEON_COOKIE_SECURE=false
DONEGEON_COOKIE_SAMESITE=lax
DONEGEON_COOKIE_DOMAIN=

# Authentication Settings
DONEGEON_AUTH_SESSION_TTL=720h
DONEGEON_AUTH_CODE_TTL=10m
DONEGEON_AUTH_CODE_LENGTH=6
DONEGEON_AUTH_MAX_CODE_ATTEMPTS=5
DONEGEON_AUTH_CODE_PEPPER=another-secret-pepper-string
DONEGEON_AUTH_DEBUG_CODE=true

# Email Delivery (for OTP)
DONEGEON_EMAIL_SEND_URL=
DONEGEON_EMAIL_SEND_AUTH_HEADER=Authorization
DONEGEON_EMAIL_SEND_AUTH_VALUE=

# Application Paths
DONEGEON_BOARD_CONFIG_PATH=donegeon_config.yml
DONEGEON_QUEST_CONFIG_PATH=docs/quests.yaml
